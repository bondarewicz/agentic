<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".env" Condition="Exists('.env')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Compile Remove="tests/**;workspace/**" />
    <InternalsVisibleTo Include="Tests" />
    <PackageReference Include="Anthropic" Version="12.58.0" />
  </ItemGroup>

</Project>
